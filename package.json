{
  "name": "keycloak-nest-template",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && node scripts/copy-build-assets.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:seed": "tsx --env-file=.env src/database/seeders/seed.ts",
    "prisma:db:deploy": "prisma migrate deploy",
    "db:dev:rm": "docker compose rm db -s -f -v",
    "db:dev:up": "docker compose up db -d",
    "db:dev:restart": "npm run db:dev:rm && npm run db:dev:up && sleep 1 && npm run prisma:db:deploy",
    "prisma:generate:store": "prisma generate --config=prisma.store.config.ts",
    "prisma:migrate:store:dev": "prisma migrate dev --config=prisma.store.config.ts",
    "prisma:migrate:store:all": "npx tsx src/database/scripts/migrate-all-stores.ts",
    "db:provision:all": "npx tsx src/database/scripts/provision-all-stores.ts",
    "db:backfill:permissions": "npx tsx src/database/scripts/backfill-role-permissions.ts",
    "db:backfill:selling-sku-master-images": "node dist/src/database/scripts/backfill-selling-sku-images-by-barcode.js",
    "db:cleanup:categories": "node dist/scripts/cleanup-categories.js",
    "db:cleanup:barcode-whitespace": "node dist/scripts/normalize-barcode-whitespace.js",
    "db:cleanup:barcode-aim-prefix": "node dist/scripts/strip-aim-barcode-prefix.js",
    "test:barcode-whitespace-cleanup": "node --test scripts/normalize-barcode-whitespace.test.js",
    "test:barcode-aim-prefix": "node --test scripts/strip-aim-barcode-prefix.test.js",
    "db:sync:store-categories": "node dist/scripts/sync-categories-to-stores.js",
    "db:sync:store-master-skus": "node dist/scripts/sync-master-skus-to-stores.js",
    "db:merge:store-15-products": "node dist/scripts/merge-store-15-duplicate-products.js",
    "db:merge:store-15-brands": "node dist/scripts/merge-store-15-duplicate-brands.js",
    "test:category-cleanup": "node --test scripts/cleanup-categories.test.js",
    "test:category-sync": "node --test scripts/sync-categories-to-stores.test.js",
    "test:master-sku-sync": "node --test scripts/sync-master-skus-to-stores.test.js",
    "test:store-product-merge": "node --test scripts/merge-store-15-duplicate-products.test.js",
    "test:store-brand-merge": "node --test scripts/merge-store-15-duplicate-brands.test.js",
    "db:link-existing-user": "tsx --env-file=.env src/database/scripts/link-exisiting-user.ts",
    "prisma:migrate:store:reset": "npx tsx src/database/scripts/reset-all-stores.ts",
    "prisma:migrate:store:reset:one": "npx tsx src/database/scripts/reset-store.ts",
    "mqtt:test": "tsx --env-file=.env src/modules/mqtt/scripts/test-publish.ts",
    "db:dedup:junction": "tsx --env-file=.env src/database/scripts/dedup-sku-category.ts",
    "db:normalize:status": "tsx --env-file=.env scripts/normalize-store-status-values.ts",
    "db:normalize:status:dry": "tsx --env-file=.env scripts/normalize-store-status-values.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1027.0",
    "@aws-sdk/lib-storage": "^3.1027.0",
    "@aws-sdk/s3-request-presigner": "^3.1027.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@keycloak/keycloak-admin-client": "^26.5.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@scalar/nestjs-api-reference": "^1.0.23",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "entities": "^8.0.0",
    "helmet": "^8.1.0",
    "i": "^0.3.7",
    "keycloak-connect": "^26.1.1",
    "mqtt": "^5.10.1",
    "nest-keycloak-connect": "^1.10.1",
    "nest-winston": "^1.10.2",
    "npm": "^11.12.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.7",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "lodash": "^4.18.1",
    "prettier": "^3.4.2",
    "prisma": "^7.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(htmlparser2|entities|domhandler|domutils|dom-serializer|domelementtype)/)"
    ]
  }
}
