{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/otp/proto/*.proto",
        "outDir": "dist/src"
      },
      {
        "include": "modules/non-cannopy-skus-admin/proto/*.proto",
        "outDir": "dist/src"
      },
      {
        "include": "modules/auth-system-user-grpc/proto/*.proto",
        "outDir": "dist/src"
      },
      {
        "include": "modules/data-sync-grpc/proto/*.proto",
        "outDir": "dist/src"
      }
    ]
  }
}
