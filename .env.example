# Number of reverse-proxy hops in front of this service. Rate limiting keys on
# the client IP, so this must match the deployment or every caller is counted
# as one. 1 for a single nginx/ingress; raise it if a CDN sits in front too.
TRUST_PROXY_HOPS=1

# Rate limiting (ThrottlerGuard). On by default — set to false only for local
# development or load testing, where 429s from the burst tier get in the way.
THROTTLE_ENABLED=true

# PostgreSQL (docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nest_template?schema=public"

# Keycloak (docker-compose)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM_NAME=system
KEYCLOAK_CLIENT_ID=api-service
KEYCLOAK_CLIENT_SECRET=ms3F1terD9MU9Ae2vpV1iIbTMijQDac2
KEYCLOAK_GRANT_TYPE=client_credentials

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=simple-bucket

NODE_ENV="development"

PORT=4000
